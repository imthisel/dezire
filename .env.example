# Copy this file to .env.local and fill in the values from
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Payments (Paddle) — see SETUP-PAYMENTS.md. These are public (the checkout needs them in the browser).
# sandbox while testing (fake cards); leave empty or set to production when live.
VITE_PADDLE_ENV=sandbox
# Paddle → Developer tools → Authentication → Client-side tokens (test_… in sandbox, live_… when live).
VITE_PADDLE_CLIENT_TOKEN=
# Paddle → Catalog → Products → Dizayr → the price's ID (pri_…).
VITE_PADDLE_PRICE_ANNUAL=
VITE_PADDLE_PRICE_SEMIANNUAL=

# Server only (Vercel → Settings → Environment Variables, never in .env.local or the browser):
# PADDLE_WEBHOOK_SECRET=the notification destination's secret key (pdl_ntfset_…)
# PADDLE_API_KEY=a Paddle API key (Developer tools → Authentication → API keys), for Manage billing and upgrades
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}  (the whole JSON file, on one line)
# ADMIN_PASSWORD=the password for the admin page at /admin (8+ characters; use 16+ random ones). Admin is off until it's set.
