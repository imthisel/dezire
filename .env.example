# Copy this file to .env.local and fill in the values from
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Payments (Lemon Squeezy) — see README → Payments.
# Checkout links for each plan (Lemon Squeezy → Products → the variant → Share → checkout link).
VITE_LS_CHECKOUT_ANNUAL=
VITE_LS_CHECKOUT_SEMIANNUAL=
# Optional: your store address, e.g. https://dizayr.lemonsqueezy.com (for the "Manage billing" link; taken from the checkout links if left out).
VITE_LS_STORE_URL=

# Server only (Vercel → Settings → Environment Variables, never in .env.local or the browser):
# LEMONSQUEEZY_WEBHOOK_SECRET=the signing secret you typed when creating the webhook
# LS_VARIANT_ANNUAL=variant id of the yearly plan
# LS_VARIANT_SEMIANNUAL=variant id of the 6-month plan
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}  (the whole JSON file, on one line)
# ADMIN_PASSWORD=the password for the admin page at /admin (8+ characters). Admin is off until it's set.
